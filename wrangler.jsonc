{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-crm",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mini-crm",
      "database_id": "1bfdab4d-4433-470a-85fd-5ed69a64fae3"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
